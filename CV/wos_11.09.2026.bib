Address = {AVENUE DU TRIBUNAL FEDERAL 34, LAUSANNE, CH-1015, SWITZERLAND},
Type = {Article},
Language = {English},
Affiliation = {Cobo-Sánchez, L (Corresponding Author), Univ Algarve, Interdisciplinary Ctr Archaeol \& Evolut Hu, ICArEHB, Campus Gambelas, Faro, Portugal.
